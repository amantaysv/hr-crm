# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Абсолютный URL сайта. Нужен для ссылки на админку в письме админу —
# без схемы http(s) ссылка не подставляется.
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# Resend. Без RESEND_API_KEY письма не отправляются, приложение работает как обычно.
RESEND_API_KEY=
# Адрес, на который приходят уведомления о новых откликах.
ADMIN_NOTIFICATION_EMAIL=
# Отправитель. onboarding@resend.dev — песочница Resend: доставка идёт ТОЛЬКО
# на почту владельца аккаунта, письма кандидатам в этом режиме не отправляются.
# После верификации домена: hr@ваш-домен.kg
RESEND_FROM_EMAIL=onboarding@resend.dev
